# ==============================================================================
# CTFDownloader Configuration
# ==============================================================================
# Copy this file to `.env` in your project root or set these environment variables:
#   cp .env.example .env
#
# Environment variables defined in your system shell take precedence over `.env`.

# Base URL of the CTFd instance (Required)
# Example: https://demo.ctfd.io or https://ctf.example.com
CTF_BASE_URL=https://ctf.example.com

# ------------------------------------------------------------------------------
# Authentication Option 1: API Token (Recommended for CTFd)
# Generate your token in CTFd: Profile -> Settings -> Access Tokens -> Generate
# ------------------------------------------------------------------------------
CTF_TOKEN=

# ------------------------------------------------------------------------------
# Authentication Option 2: Username & Password
# Used when API tokens are disabled or not available.
# ------------------------------------------------------------------------------
CTF_USERNAME=
CTF_PASSWORD=

# ------------------------------------------------------------------------------
# Rate Limiting & Network Configuration
# Adds a random delay (in seconds) between requests to avoid triggering WAFs
# or rate limits during large competitions.
# ------------------------------------------------------------------------------
RATE_MIN_DELAY=1.0
RATE_MAX_DELAY=3.0
